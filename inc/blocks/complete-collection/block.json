{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "180c/complete-collection",
  "title": "Collection complète",
  "category": "180c",
  "icon": "grid-view",
  "description": "Grille de tous les numéros avec indicateur d'achat pour les abonnés connectés.",
  "keywords": ["collection", "numéros", "grille", "archives"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "La collection complète"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "show_purchased_indicator": {
      "type": "boolean",
      "default": true
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css"
}
