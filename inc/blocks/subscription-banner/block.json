{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "180c/subscription-banner",
  "title": "Bannière abonnement",
  "category": "180c",
  "icon": "star-filled",
  "description": "CTA pleine largeur pour l'abonnement recettes. Masqué automatiquement pour les abonnés actifs.",
  "keywords": ["abonnement", "subscription", "cta", "premium"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Accédez à toutes les recettes"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "cta_label": {
      "type": "string",
      "default": "Je m'abonne"
    },
    "image_url": {
      "type": "string",
      "default": ""
    },
    "hide_for_subscribers": {
      "type": "boolean",
      "default": true
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css"
}
